# Required
BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user IDs allowed to use the bot (first one = admin, gets cookie-expiry alerts)
ALLOWED_USER_IDS=123456789

# Downloader
DOWNLOAD_TIMEOUT=300      # single posts, seconds
PROFILE_IDLE_TIMEOUT=300  # profiles/stories: stop if no new file for this many seconds (no total limit)
MAX_CONCURRENT=1
REQUEST_DELAY=3
MAX_UPLOAD_MB=50

# Optional: local Telegram Bot API server (lifts upload limit to 2000 MB; set MAX_UPLOAD_MB=2000)
# LOCAL_API_URL=http://127.0.0.1:8081
